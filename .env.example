# Backend
PORT=4001
DATABASE_URL=postgresql://recycling_user:change_me_local_only@localhost:5433/recycling_db
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
FRONTEND_ORIGIN=http://localhost:5173

# Hedera Testnet only (Chain ID 296) — never Mainnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
# Optional Hedera account id (0.0.x) if known
OPERATOR_ACCOUNT_ID=
# EVM address derived from BACKEND_OPERATOR_PRIVATE_KEY (for check:hedera)
OPERATOR_EVM_ADDRESS=
# ECDSA secp256k1 private key as 0x + 64 hex — never commit; fund via portal.hedera.com/faucet
BACKEND_OPERATOR_PRIVATE_KEY=
# Filled automatically by: npm run deploy:testnet
REGISTRY_CONTRACT_ADDRESS=
TOKEN_CONTRACT_ADDRESS=
TX_CONFIRMATIONS=1
TX_WAIT_TIMEOUT_MS=120000
# Reconcile PROCESSING declarations on API boot (never submits a second mint)
RECONCILE_ON_STARTUP=true

# ECO reward policy (server-side only; amounts computed in integer wei)
# Default rates (ECO/kg): plastic 12, metal 15, aluminum 18, glass 8, paper 5,
# cardboard 4, organic 2, electronic 25, other 3
REWARD_RATES_JSON=
REWARD_MAX_ECO_PER_DECLARATION=1000
# Minimum quantity in millis of kg (100 = 0.1 kg)
REWARD_MIN_QUANTITY_MILLIS=100

# Gemini (server-side only — never expose in the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local AI waste recognition (Trash Classifier V2 — no paid API)
AI_SERVICE_URL=http://127.0.0.1:5001
AI_TIMEOUT_MS=60000
AI_MAX_UPLOAD_BYTES=5242880
# Optional absolute path for declaration photos (default: backend/uploads/declarations)
UPLOADS_DIR=

# ─── HCS (Feature A) — create via: npm run create:hcs-topic ─────────────────
HCS_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ─── EcoTree NFT HTS (Feature B) — create via: npm run create:tree-collection ─
TREE_TOKEN_ID=
# Public API base for NFT metadata / SVG pointers
PUBLIC_API_BASE_URL=http://localhost:4001
